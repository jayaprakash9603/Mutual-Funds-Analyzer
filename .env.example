# Copy to .env and adjust as needed before `docker compose up`

# Image tags on Docker Hub (jayaprakash9603/mfa-backend, jayaprakash9603/mfa-frontend)
MFA_VERSION=1.0.3

MYSQL_DATABASE=mfa
MYSQL_USER=root
MYSQL_PASSWORD=123456

# Host ports
# Use 8088 on Windows if port 80 is reserved by the OS
FRONTEND_PUBLISH_PORT=8088
BACKEND_PUBLISH_PORT=8080
MYSQL_PUBLISH_PORT=3306

# Optional JVM tuning for the backend container
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

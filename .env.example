# Copy to .env and adjust as needed before `docker compose up --build`

MYSQL_DATABASE=mfa
MYSQL_USER=root
MYSQL_PASSWORD=123456

# Host ports
FRONTEND_PUBLISH_PORT=80
BACKEND_PUBLISH_PORT=8080
MYSQL_PUBLISH_PORT=3306

# Optional JVM tuning for the backend container
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
